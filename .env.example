# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# GEMINI_API_KEY: Powers brand analysis, content writing, Gemini images, and Veo video.
# Without it the app runs in demo mode (images still generate free via Pollinations).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# KLING_ACCESS_KEY / KLING_SECRET_KEY: Enables Kling image-to-video generation
# (first choice in the video provider cascade). https://klingai.com
KLING_ACCESS_KEY=""
KLING_SECRET_KEY=""

# HIGGSFIELD_API_KEY: Enables Higgsfield cinematic video generation
# (second choice in the video provider cascade). https://cloud.higgsfield.ai
HIGGSFIELD_API_KEY=""

# CANVA_TEMPLATE_URL: Optional. A Canva template/design URL that the carousel
# editor's "Open in Canva" button opens instead of a blank design.
CANVA_TEMPLATE_URL=""

# META_APP_ID / META_APP_SECRET: Enables the real Meta (Instagram) connection.
# Create a Business-type app at developers.facebook.com, add the Facebook Login
# + Instagram Graph API products, and whitelist {APP_URL}/api/meta/callback as
# an OAuth redirect URI. See README "Real Instagram publishing" for the full
# checklist. NOTE: publishing requires APP_URL to be a PUBLIC https origin —
# Meta's servers fetch your post images from {APP_URL}/media/:key.
META_APP_ID=""
META_APP_SECRET=""

# ANTHROPIC_API_KEY: Optional. Used by the /api/anthropic proxy route.
ANTHROPIC_API_KEY=""

# DB_PATH: SQLite file location. Defaults to ./data.db locally. On Render the
# render.yaml blueprint sets this to /data/data.db so the persistent disk
# holds it (brands, campaigns, posts, Meta tokens all survive redeploys).
DB_PATH=""
